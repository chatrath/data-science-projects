# Copy to .env only for a fresh project; preserve existing credentials.
# SELECT-only chat/search role; bootstrap is stored in .local-db/bootstrap.env.
DATABASE_URL=
# Ingestion/table-owner role. Blank retains legacy single-URL behavior.
DATABASE_INGEST_URL=
LLM_PROVIDER=ollama
# Native Ollama URL (no /v1); no API key required.
OLLAMA_BASE_URL=http://localhost:11434
# Alternative: qwen2.5:7b
OLLAMA_CHAT_MODEL=qwen3:4b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768

# Optional hosted provider: LLM_PROVIDER=nebius
NEBIUS_API_KEY=
# Optional: blank uses https://api.tokenfactory.nebius.com/v1/
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
NEBIUS_EMBEDDING_DIMENSIONS=4096
# Set an exact generation model ID activated for your Nebius account.
NEBIUS_CHAT_MODEL=

# Optional OpenAI fallback: set LLM_PROVIDER=openai explicitly.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=

# Local performance settings; blank thread count lets Ollama choose.
EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=3
RAG_CONTEXT_BYTES=5000
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=600
OLLAMA_NUM_THREAD=

# Local SQLite semantic response cache; false bypasses it immediately.
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=256

# Optional bounded corrective LangGraph pipeline (default: false).
ENABLE_AGENT_GRAPH=false

# Process-wide active chat requests; excess requests are rejected without queuing.
MAX_CONCURRENT_REQUESTS=2

# Agent multi-part evidence: up to two precise chunks per part, six overall.
RAG_MULTI_CHUNKS_PER_QUERY=2
RAG_MULTI_MAX_CHUNKS=6
# Byte budget is also bounded by OLLAMA_NUM_CTX after prompt/output reserves.
RAG_MULTI_CONTEXT_BYTES=10000
RAG_MULTI_NUM_PREDICT=384
